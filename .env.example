# Variáveis de ambiente — Landing Page (Anúncio & Site)
# Copie para .env.local e preencha com valores reais.
# Não versionar .env.local.

# Google Apps Script — endpoint do web app para envio de leads
GOOGLE_APPS_SCRIPT_WEB_APP_URL=

# Google Apps Script — secret compartilhado para autenticação (servidor apenas)
GOOGLE_APPS_SCRIPT_SECRET=

# WhatsApp — número em formato 55DDDNUMERO (pode ser usada no cliente)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4
NEXT_PUBLIC_GA4_ID=

# Google Ads
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=
